{
    "manifest_version": 3,
    "name": "會議室語音助理 (基礎版)",
    "version": "1.0",
    "permissions": [
        "activeTab",
        "scripting",
        "downloads",
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "options_page": "options.html",
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "pinyin-pro.js",
                "content.js"
            ]
        },
        {
            "matches": [
                "https://meeting.cdc.gov.tw/*"
            ],
            "css": [
                "style.css"
            ],
            "js": [
                "redesign.js"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "assets/font/Iansui-Regular.ttf",
                "assets/icons/icon-svg/*.svg"
            ],
            "matches": ["https://meeting.cdc.gov.tw/*"]
        }
    ]
}